// CLD-0002 | Step 4: Were the submitted credentials used?
// Takes the users who submitted credentials and lists their successful
// sign-ins (ResultType == "0"). Returns 9 records across the two accounts.
let CredVictims = CloudoraMsgTrace_CL
    | where EventType == "Click" and CredentialsSubmitted == "Yes"
    | distinct RecipientAddress;
CloudoraSignin_CL
| where UserPrincipalName in (CredVictims)
| where ResultType == "0"
| project TimeGenerated, UserPrincipalName, AppDisplayName, IPAddress,
          City, Country, DeviceOS, Browser
| order by UserPrincipalName asc, TimeGenerated asc
